# Telegram credentials for a USERBOT (logs in as your real account, not
# an official bot). Get API_ID / API_HASH from https://my.telegram.org.
API_ID=
API_HASH=

# --- Login: set ONE of these two ---
# For the first-ever local login (run generate_session.py), set your
# phone number here in international format, e.g. +91XXXXXXXXXX.
PHONE_NUMBER=
# After running generate_session.py once, paste the printed string here
# (and set this on Railway) so the bot can start headless, no OTP needed.
# Leave PHONE_NUMBER set too as a fallback is fine; SESSION_STRING takes
# priority if both are set.
SESSION_STRING=

# Chat where review logs, retraining confirmations, and mute/ban actions
# get posted. Must be a chat/channel your account is a member of. Use a
# negative id for groups/channels (e.g. -1001234567890).
ADMIN_CHAT_ID=

# Persistent storage. On Railway: create a Volume, mount it at /data,
# and set DATA_DIR=/data so weights/strikes/labeled data survive redeploys.
DATA_DIR=.

# --- Classifier thresholds (ML anchor classifier: pm/dm/msg/akka/aunty/fwb/ex) ---
WARN_THRESHOLD=1.5
SAFE_THRESHOLD=-1.5

# --- Strike escalation (used by both the blocklist path and any future
#     abuse/argument feature) ---
STRIKE_LIMIT_MUTE=3
STRIKE_LIMIT_BAN=5
MUTE_MINUTES=60

# --- DM-intention action (fixed mute, used when the classifier itself
#     scores "warn", or "uncertain" with DM-solicitation wording present) ---
DM_MUTE_HOURS=3

# --- Conversation / instigator tracking ---
CONTEXT_WINDOW_SECONDS=300
MAX_HISTORY_PER_CHAT=50
